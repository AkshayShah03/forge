# Multi-Agent Azure System — environment variables
# Copy to .env and fill in values before running

# ── Groq (cloud inference — free tier at console.groq.com) ───────────────────
GROQ_API_KEY=gsk_...                   # Set this to use Groq; leave blank to use Ollama
GROQ_MODEL=llama-3.1-8b-instant       # Groq model (llama-3.1-8b-instant, llama-3.3-70b-versatile, etc.)

# ── Ollama (local fallback when GROQ_API_KEY is not set) ──────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
TAVILY_API_KEY=tvly-...                 # Optional: web search (Tavily)

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/agents

# ── Azure Service Bus ─────────────────────────────────────────────────────────
AZURE_SERVICE_BUS_NAMESPACE=           # e.g. myagents.servicebus.windows.net (empty = dev mode)
AZURE_TASK_QUEUE_NAME=task-inbox
AZURE_RESULT_QUEUE_NAME=result-outbox

# ── MCP Servers ───────────────────────────────────────────────────────────────
MCP_SERVERS={}                         # JSON dict of MCP server configs

# ── Per-role model overrides (optional, defaults to OLLAMA_MODEL) ─────────────
ORCHESTRATOR_MODEL=llama3.1:8b
SUB_AGENT_MODEL=llama3.1:8b
CODER_MODEL=qwen2.5-coder:7b
CRITIC_MODEL=llama3.1:8b

# ── Quality threshold ─────────────────────────────────────────────────────────
QUALITY_THRESHOLD=0.75                 # Critic score >= this → task passes

# ── Agent workspace ───────────────────────────────────────────────────────────
AGENT_WORKSPACE=/tmp/agent_workspace   # Where coder writes/reads files

# ── Optional services ─────────────────────────────────────────────────────────
RAG_SERVICE_URL=                       # Optional: RAG retrieval service URL
ANALYTICS_DB_URL=                      # Optional: read-only analytics database
